# Byte-compiled / cache
__pycache__/
*.py[cod]
*.pyo

# Build output. The plugin writes builds into N.E.K.O's runtime data root rather
# than beside its own source, so nothing here should normally exist; these rules
# are here so a manual `--workdir` inside the checkout cannot get committed.
.build/
build/
dist/
*-standalone/
*.zip
*.egg-info/

# Runtime state the N.E.K.O host may drop next to the plugin source.
store.db
.env

# Generated voice packs are ~36 MiB of audio and are reproducible from
# data/lines.zh-CN.json plus a TTS call. Publish them as release assets, not as
# commits.
*.wav
!data/**/*.wav

# Local tooling
.venv/
venv/
vendor/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.DS_Store
Thumbs.db
